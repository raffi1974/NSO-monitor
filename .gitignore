# NSO monitor - things that should never be committed, because they're either regenerated by the
# pipeline itself, machine/OS-specific, or (for data/) too large for git (see docs/folder_design.docx -
# the daily databases are meant to live in a GitHub Release asset, not in git history).
#
# NOT listed here on purpose, even though they're not part of today's first commit: config/, nso_monitor/,
# tests/, docs/, output/, .claude/, .github/ - these are real source/deliverables meant to be tracked once
# you're ready to add them, just not swept in by an untargeted `git add .`.

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
.venv/
venv/
env/
ENV/
build/
dist/

# Agent 2's daily databases - regenerated by the pipeline; the real copies live in a GitHub Release
/data/
*.sqlite
*.sqlite3
*.db

# build_dashboard.py's output - fully regenerated from output/agent1/*.json + data/*/catalogue.sqlite
# (the leading slash matters: it excludes only the top-level build output, not nso_monitor/dashboard/,
# which is the Python package - template, builder - and must stay tracked)
/dashboard/

# secrets / local environment
.env
.env.*
*.pem
*.key

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
